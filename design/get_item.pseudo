START get_item

    SET current_room
    SET room_item to item located in current_room
    SET inventory to player's current inventory

    OUTPUT "Enter your move:"
    INPUT player_command

    IF player_command equals "get " + room_item

        ADD room_item to inventory
        OUTPUT room_item + " retrieved!"

        SET room_item to NONE

    ELSE

        OUTPUT "Can't get that item!"

    ENDIF

    CONTINUE game_loop

END get_item


