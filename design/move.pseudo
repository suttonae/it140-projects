START move_between_rooms

    # Identify the information needed for movement.
    SET current_room to player's current room
    SET game_running to TRUE

    # Continue accepting commands while the game is running.
    WHILE game_running equals TRUE

        # Prompt for and receive the player's movement command.
        OUTPUT "Enter your move:"
        INPUT movement_command

        # Check whether the requested direction is possible
        # from the player's current room.
        IF movement_command is a valid direction from current_room

            # Move the player to the connected room.
            SET current_room to room in movement_command direction

            # Tell the player their new location.
            OUTPUT "You are in the " + current_room

        ELSE

            # Tell the player that movement is not possible.
            OUTPUT "You can't go that way!"

        ENDIF

        # Continue the gameplay loop until a win or loss occurs.

    ENDWHILE
